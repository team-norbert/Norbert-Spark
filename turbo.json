{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "packages/shared/dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:debug": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.json", "eslint.config.*"],
      "cache": false
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "cache": false
    },
    "test:unit": {
      "dependsOn": ["^build", "^test:unit"]
    },
    "test:unit:coverage": {
      "dependsOn": ["^build", "^test:unit:coverage"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["^build", "^test:e2e"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint:api": {
      "dependsOn": ["^lint:api"]
    }
  }
}
