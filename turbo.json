{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "packages/shared/dist/**"],
      "env": [
        "NEXTAUTH_SECRET",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "GOOGLE_ID",
        "GOOGLE_SECRET",
        "BACKEND_AI_CALLBACK_URL",
        "BACKEND_URL",
        "OAUTH_SYNC_SECRET",
        "NEXTAUTH_URL",
        "NEXT_PUBLIC_POST_AI_CALLBACK_URL",
        "NEXT_PUBLIC_BASE_URL",
        "NEXT_PUBLIC_BACKEND_URL",
        "DEFAULT_RATE_LIMIT_WINDOW",
        "DEFAULT_RATE_LIMIT_MAX",
        "TRUSTED_PROXIES",
        "NODE_ENV",
        "NEXT_PUBLIC_NODE_ENV"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:debug": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.json", "eslint.config.*"],
      "cache": false
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "cache": false
    },
    "test:unit": {
      "dependsOn": ["^build", "^test:unit"]
    },
    "test:unit:coverage": {
      "dependsOn": ["^build", "^test:unit:coverage"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["^build", "^test:e2e"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint:api": {
      "dependsOn": ["^lint:api"]
    }
  }
}
