{
  "name": "norberts-spark",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for Norbert's Spark with frontend and backend and shared package",
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:debug": "turbo dev:debug",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "test": "turbo test:unit",
    "test:unit:coverage": "turbo test:unit:coverage",
    "test:e2e": "turbo test:e2e --filter @norberts-spark/frontend",
    "lint:api": "pnpm --filter @norberts-spark/shared lint:api",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\" --cache",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "prepare": "husky",
    "docker:build": "docker build -t norberts-spark-backend -f apps/backend/Dockerfile .",
    "docker:db": "docker-compose up -d postgres",
    "docker:db:stop": "docker-compose down",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:prod:stop": "docker-compose -f docker-compose.prod.yml down"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.23.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@typescript-eslint/utils": "^8.57.1",
    "@vitest/eslint-plugin": "^1.6.12",
    "eslint": "^10.0.3",
    "eslint-config-turbo": "^2.8.17",
    "eslint-plugin-codegen": "^0.34.1",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.8.0",
    "eslint-plugin-playwright": "^2.10.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "turbo": "^2.8.17"
  },
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "eslint-plugin-jsx-a11y>minimatch": "^3.1.3",
      "dompurify@<3.3.2": ">=3.3.2",
      "esbuild@<=0.24.2": ">=0.25.0",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@>=5.0.0 <5.1.7": ">=5.1.7",
      "redoc@<2.4.0": ">=2.4.0",
      "rollup@<2.80.0": ">=2.80.0",
      "underscore@<1.13.8": ">=1.13.8",
      "serialize-javascript@<7.0.3": ">=7.0.3",
      "tar@<7.5.10": ">=7.5.10",
      "flatted@<3.4.0": ">=3.4.0",
      "undici@<7.24.0": ">=7.24.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@10.29.3",
  "preinstall": "npx --yes only-allow pnpm",
  "dependencies": {
    "zod": "^4.3.6"
  }
}
