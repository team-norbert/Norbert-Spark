{
  "name": "norberts-spark",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for Norbert's Spark with frontend and backend and shared package",
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:debug": "turbo dev:debug",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "test": "turbo test:unit",
    "test:unit:coverage": "turbo test:unit:coverage",
    "test:e2e": "turbo test:e2e --filter @norberts-spark/frontend",
    "lint:api": "pnpm --filter @norberts-spark/shared lint:api",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\" --cache",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "prepare": "husky",
    "docker:build": "docker build -t norberts-spark-backend -f apps/backend/Dockerfile .",
    "docker:run": "docker run -p 3001:3001 -e PORT=3001 --env-file apps/backend/.env --name norbertsSpark-backend norberts-spark-backend",
    "docker:remove": "docker rm norbertsSpark-backend",
    "docker:stop": "docker stop norbertsSpark-backend"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.39.2",
    "@redocly/cli": "^2.19.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@typescript-eslint/utils": "^8.56.0",
    "@vitest/eslint-plugin": "^1.6.9",
    "eslint": "^9.39.2",
    "eslint-config-turbo": "^2.8.10",
    "eslint-plugin-codegen": "^0.34.1",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.6.0",
    "eslint-plugin-playwright": "^2.7.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "turbo": "^2.8.10"
  },
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@10.29.3",
  "preinstall": "npx --yes only-allow pnpm",
  "dependencies": {
    "zod": "^4.3.6"
  }
}
