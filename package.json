{
  "name": "norberts-spark",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for Norbert's Spark with frontend and backend and shared package",
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:debug": "turbo dev:debug",
    "build": "TURBO_SCM_BASE=origin/main turbo build --affected",
    "lint": "TURBO_SCM_BASE=origin/main turbo lint --affected",
    "lint:fix": "TURBO_SCM_BASE=origin/main turbo lint:fix --affected",
    "test": "TURBO_SCM_BASE=origin/main turbo test:unit --affected",
    "test:unit:coverage": "turbo test:unit:coverage",
    "test:e2e": "turbo test:e2e --filter @norberts-spark/frontend",
    "lint:api": "pnpm --filter @norberts-spark/shared lint:api",
    "typecheck": "TURBO_SCM_BASE=origin/main turbo typecheck --affected",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\" --cache",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "prepare": "husky",
    "docker:build": "docker build -t norberts-spark-backend -f apps/backend/Dockerfile .",
    "docker:db": "docker-compose up -d postgres",
    "docker:db:stop": "docker-compose down",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:prod:stop": "docker-compose -f docker-compose.prod.yml down"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.20.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@typescript-eslint/utils": "^8.55.0",
    "@vitest/eslint-plugin": "^1.6.7",
    "eslint": "^10.0.2",
    "eslint-config-turbo": "^2.8.13",
    "eslint-plugin-codegen": "^0.34.1",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.5.4",
    "eslint-plugin-playwright": "^2.9.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "turbo": "^2.8.13"
  },
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "eslint-plugin-jsx-a11y>minimatch": "^3.1.3"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@10.29.3",
  "preinstall": "npx --yes only-allow pnpm",
  "dependencies": {
    "zod": "^4.3.6"
  }
}
