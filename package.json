{
  "name": "norberts-spark",
  "version": "0.1.4",
  "private": true,
  "description": "Monorepo for Norbert's Spark with frontend and backend and shared package",
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:debug": "turbo dev:debug",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "test": "turbo test:unit",
    "test:unit:coverage": "turbo test:unit:coverage",
    "test:e2e": "turbo test:e2e --filter @norberts-spark/frontend",
    "lint:api": "pnpm --filter @norberts-spark/shared lint:api",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\" --cache",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "prepare": "husky",
    "docker:build": "node -e \"const {execFileSync}=require('child_process'); const v=require('./package.json').version; execFileSync('docker', ['build', '--build-arg', 'APP_VERSION=' + v, '-t', 'norberts-spark-backend:' + v, '-f', 'apps/backend/Dockerfile', '.'], { stdio: 'inherit' });\"",
    "docker:db": "docker-compose up -d postgres",
    "docker:db:stop": "docker-compose down",
    "docker:prod": "node -e \"const {execSync}=require('child_process'); const v=require('./package.json').version; execSync('docker-compose up -d', { stdio: 'inherit', env: { ...process.env, APP_VERSION: v } });\"",
    "docker:prod:stop": "docker-compose down"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.25.1",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@typescript-eslint/utils": "^8.57.2",
    "@vitest/eslint-plugin": "^1.6.13",
    "eslint": "^10.1.0",
    "eslint-config-turbo": "^2.8.20",
    "eslint-plugin-codegen": "^0.34.1",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.8.1",
    "eslint-plugin-playwright": "^2.10.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "turbo": "^2.8.20"
  },
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "eslint-plugin-jsx-a11y>minimatch": "^3.1.3"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@10.29.3",
  "preinstall": "npx --yes only-allow pnpm",
  "dependencies": {
    "zod": "^4.3.6"
  }
}
