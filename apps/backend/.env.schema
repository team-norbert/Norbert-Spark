# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# IMPORTANT: Whenever this file is updated, run `pnpm exec varlock typegen` to regenerate
# the env.d.ts file with the correct types and default values based on the annotations in this file.
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# PostgreSQL Configuration
POSTGRES_USER=postgres
# @sensitive
POSTGRES_PASSWORD=postgres
POSTGRES_DB=norbertsSpark
POSTGRES_INITDB_ARGS=-E UTF8 --locale=en_GB.UTF-8
# @type=url
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/norbertsSpark
# @type=boolean
DATABASE_SSL_ENABLED=false
# @type=boolean
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# @type=number
DATABASE_CONNECTION_TIMEOUT_MS=5000
# @type=number
DATABASE_IDLE_TIMEOUT_MS=30000
# @type=number
DATABASE_POOL_MAX=20
# @type=number
DATABASE_POOL_MIN=5
# @type=number
DATABASE_POOL_MAX_LIFETIME_SECONDS=60
# @type=url
# @sensitive
REDIS_URL=redis://:changeme@redis:6379
# Redis password - must match REDIS_PASSWORD in docker-compose.yml
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# @sensitive
REDIS_PASSWORD=changeme

# Local set up
# @type=boolean
USE_HTTPS=true
NODE_ENV=development
# @type=port
PORT=3001
HOST=127.0.0.1
# @type=url
PACT_BROKER_URL=http://localhost:9292
# @type=port
PACT_BROKER_PORT=9292
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# @sensitive
JWT_SECRET=your_jwt_secret_here
# # Shared secret for authenticating frontend OAuth sync requests to backend
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# @sensitive
OAUTH_SYNC_SECRET=your-oauth-sync-shared-secret-here
JWT_ISSUER=your-app-name
# @type=number
JWT_EXPIRATION=3600
LOG_LEVEL=info
API_VERSION=v1
# Third party API key and configuration
# https://aistudio.google.com/app/apikey
# @sensitive
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key_here
# @sensitive
GOOGLE_API_KEY=your_google_api_key_here
MODEL_NAME=gemini-2.5-flash
# https://resend.com/
# @sensitive
RESEND_API_KEY=your_resend_api_key_here
# @type=email
EMAIL_FROM_ADDRESS=onboarding@resend.dev
# UPSTASH
# @type=url
UPSTASH_REDIS_REST_URL=https://placeholder.upstash.io
# @sensitive
UPSTASH_REDIS_REST_TOKEN=as-provided-by-upstash
# Sentry: https://sentry.io
# Sentry is an error tracking service that helps developers monitor and fix crashes in real time.
# By setting SENTRY_DSN, you enable Sentry error tracking in the backend.
# For above, please refer to their documentation for generating an auth token:
# https://docs.sentry.io/cli/configuration/
SENTRY_DSN=your_sentry_dsn_here
# @type=boolean
SENTRY_ENABLED=false
# For SENTRY_AUTH_TOKEN, please refer to their documentation for generating an auth token:
# https://docs.sentry.io/cli/configuration/
# @sensitive
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
CLOUDFLARE_ACCESS_ID=your_cloudflare_access_id_here
# @sensitive
CLOUDFLARE_ACCESS_SECRET=your_cloudflare_access_secret_here
CLOUDFLARE_API=your_cloudflare_api_token_here
CLOUDFLARE_ENDPOINT=your_cloudflare_endpoint_here
BUCKET=your_cloud_bucket_name_here
# @sensitive
OPENAI_API_KEY=your_openai_api_key_here

# Used for two-factor authentication (2FA) secrets encryption
# Two-factor authentication is not yet enabled. It is on the roadmap for a future release,
# but you can set up the encryption key in advance. Just make sure to keep it safe,
# as it will be required to decrypt any 2FA secrets if you enable that feature later on.
# Encryption key for sensitive data (e.g., 2FA secrets)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_KEY=your-encryption-key-here
# @type=number
REFRESH_TOKEN_EXPIRATION=604800
# @type=number
ACCESS_TOKEN_BUFFER=300
# @type=boolean
OTEL_CAPTURE_QUERY_TEXT=false

# CORS Configuration
# Comma-separated list of allowed origins for production (not needed in development)
# Example: https://norberts-spark.com,https://www.norberts-spark.com
# @type=url
ALLOWED_ORIGINS=https://your-production-domain.com
APP_VERSION=you_don't_need_to_set_this_manually_it_will_be_injected_automatically_during_build_time
SERVICE_NAME='norberts-spark-backend'