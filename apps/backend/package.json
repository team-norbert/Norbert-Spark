{
  "name": "@norbets-spark/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch src/infrastructure/di/container/index.ts",
    "dev:debug": "tsx watch --inspect src/infrastructure/di/container/index.ts",
    "build": "tsc",
    "start": "node dist/infrastructure/di/container/index.js",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "test:unit": "vitest run --hideSkippedTests",
    "test:unit:coverage": "vitest run --coverage --hideSkippedTests",
    "typecheck": "tsc --noEmit",
    "db:studio": "drizzle-kit studio",
    "db:create": "docker exec -i norbertsSpark-postgres psql -U postgres -d norbertsSpark < sql/norberts_schema.sql",
    "db:drop": "docker exec -i norbertsSpark-postgres psql -U postgres -d norbertsSpark < drizzle/drop_all_tables.sql",
    "db:reset": "pnpm db:drop && pnpm db:create",
    "seed:users": "tsx scripts/seed-users.ts",
    "seed:chat": "tsx scripts/seed-chat.ts",
    "seed:company": "tsx scripts/seed-company.ts",
    "mermaid": "tsx scripts/serve-mermaid.ts",
    "mermaid:di": "tsx scripts/serve-mermaid.ts di:container.md",
    "eval": "evalite run",
    "eval:view": "evalite view",
    "test:pact": "vitest run pact/provider.pact.spec.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.29",
    "@ai-sdk/provider": "^3.0.8",
    "@aws-sdk/client-s3": "^3.993.0",
    "@aws-sdk/s3-request-presigner": "^3.993.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@google/generative-ai": "^0.24.1",
    "@norberts-spark/shared": "workspace:*",
    "@sentry/node": "^10.39.0",
    "@smithy/node-http-handler": "^4.4.10",
    "@supercharge/promise-pool": "^3.2.0",
    "@upstash/redis": "^1.36.2",
    "ai": "^6.0.91",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.7.4",
    "js-tiktoken": "^1.0.21",
    "jsonwebtoken": "^9.0.3",
    "obscured": "^2.0.4",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "pino-logger": "^1.0.0",
    "resend": "^6.9.2",
    "unzipper": "^0.12.3",
    "uuidv7": "^1.1.0",
    "uuidv7-utilities": "^3.1.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@pact-foundation/pact": "^16.2.0",
    "@stoplight/spectral-cli": "^6.15.0",
    "@stoplight/spectral-core": "^1.21.0",
    "@stoplight/spectral-rulesets": "^1.22.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.16.0",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.9",
    "autoevals": "^0.0.131",
    "aws-sdk": "^2.1693.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.2",
    "eslint-plugin-codegen": "^0.34.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.6.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "evalite": "^0.19.0",
    "multer": "^2.0.2",
    "node-gyp": "^12.2.0",
    "pino-pretty": "^13.1.3",
    "prebuild-install": "^7.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.29.3",
  "preinstall": "npx --yes only-allow pnpm"
}
