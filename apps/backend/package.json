{
  "name": "@norberts-spark/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch src/infrastructure/di/container/index.ts",
    "dev:debug": "varlock run -- tsx watch --inspect src/infrastructure/di/container/index.ts",
    "build": "varlock run -- tsc",
    "start": "node dist/infrastructure/di/container/index.js",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "test:unit": "vitest run --hideSkippedTests",
    "test:unit:coverage": "vitest run --coverage --hideSkippedTests",
    "typecheck": "tsc --noEmit",
    "db:studio": "drizzle-kit studio",
    "db:create": "docker exec -i norbertsSpark-postgres psql -U postgres -d norbertsSpark < sql/norberts_schema.sql",
    "db:drop": "docker exec -i norbertsSpark-postgres psql -U postgres -d norbertsSpark < drizzle/drop_all_tables.sql",
    "db:reset": "pnpm db:drop && pnpm db:create",
    "seed:users": "tsx scripts/seed-users.ts",
    "seed:chat": "tsx scripts/seed-chat.ts",
    "seed:company": "tsx scripts/seed-company.ts",
    "seed:rag": "tsx scripts/seed-rag.ts",
    "mermaid": "tsx scripts/serve-mermaid.ts",
    "mermaid:di": "tsx scripts/serve-mermaid.ts di:container.md",
    "eval": "evalite run",
    "eval:view": "evalite view",
    "test:pact": "vitest run --config vitest.config.pact.ts pact/provider.pact.spec.ts",
    "test:mutation": "stryker run",
    "varlock:typegen": "pnpm exec varlock typegen"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.93",
    "@ai-sdk/cohere": "^3.0.30",
    "@ai-sdk/google": "^3.0.63",
    "@ai-sdk/huggingface": "^1.0.43",
    "@ai-sdk/mistral": "^3.0.30",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/provider": "^3.0.8",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/s3-request-presigner": "^3.1030.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@google/generative-ai": "^0.24.1",
    "@kubiks/otel-drizzle": "^2.1.0",
    "@langchain/textsplitters": "^1.0.1",
    "@norberts-spark/shared": "workspace:*",
    "@sentry/node": "^10.48.0",
    "@smithy/node-http-handler": "^4.5.2",
    "@supercharge/promise-pool": "^3.3.0",
    "@upstash/redis": "^1.37.0",
    "ai": "^6.0.161",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "file-type": "^22.0.1",
    "isomorphic-dompurify": "^3.9.0",
    "js-tiktoken": "^1.0.21",
    "jsonwebtoken": "^9.0.3",
    "obscured": "^2.0.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-logger": "^1.0.0",
    "redis": "^5.12.1",
    "resend": "^6.11.0",
    "unzipper": "^0.12.3",
    "uuidv7": "^1.2.1",
    "uuidv7-utilities": "^3.1.0",
    "varlock": "^0.8.1",
    "voyage-ai-provider": "^3.0.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pact-foundation/pact": "^16.3.0",
    "@stoplight/spectral-cli": "^6.15.1",
    "@stoplight/spectral-core": "^1.22.0",
    "@stoplight/spectral-rulesets": "^1.22.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testcontainers/postgresql": "^11.14.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.20.0",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/eslint-plugin": "^1.6.15",
    "autoevals": "^0.0.132",
    "aws-sdk": "^2.1693.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.0",
    "eslint-plugin-codegen": "^0.34.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "evalite": "^0.19.0",
    "multer": "^2.1.1",
    "node-gyp": "^12.2.0",
    "pino-pretty": "^13.1.3",
    "prebuild-install": "^7.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.33.0",
  "preinstall": "npx --yes only-allow pnpm"
}
