{
  "name": "@norberts-spark/frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev -p 4321 --experimental-https",
    "dev:debug": "next dev -p 4321 --inspect --experimental-https",
    "upgrade": "next upgrade",
    "build": "next build && shx cp -R .next/static .next/standalone/apps/frontend/.next/static",
    "start": "cross-env PORT=4321 node .next/standalone/apps/frontend/server.js",
    "start:e2e": "cross-env PORT=4321 node .next/standalone/apps/frontend/server.js",
    "bundle:analyze": "pnpm run build && next experimental-analyze",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "test:unit": "vitest run --hideSkippedTests",
    "test:unit:coverage": "vitest run --coverage --hideSkippedTests",
    "test:e2e": "cross-env E2E_CLEANUP_PROCESSES=true playwright test",
    "test:e2e:headed": "cross-env E2E_CLEANUP_PROCESSES=true playwright test --headed",
    "test:pact": "vitest run --config vitest.config.pact.ts pacts/consumer.pact.spec.ts",
    "test:publish": "pact-broker publish pacts --consumer-app-version=1.0.0 --broker-base-url=http://localhost:9293 --verbose",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/react": "^3.0.118",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@mui/material-nextjs": "^7.3.9",
    "@mui/system": "^7.3.9",
    "@mui/x-data-grid": "^8.27.5",
    "@mui/x-data-grid-generator": "^8.27.5",
    "@norberts-spark/shared": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-query": "^5.90.21",
    "@upstash/ratelimit": "^0.4.4",
    "@upstash/redis": "^1.36.4",
    "ai": "^6.0.116",
    "appwrite": "^23.0.0",
    "jiti": "^2.6.1",
    "modern-normalize": "^3.0.1",
    "mui-markdown": "^2.1.1",
    "next": "^16.1.6",
    "next-auth": "^4.24.13",
    "node-fetch": "^3.3.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shiki": "^4.0.2",
    "streamdown": "^2.4.0",
    "uuidv7": "^1.1.0",
    "uuidv7-utilities": "^3.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^2.13.0",
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "^16.1.6",
    "@pact-foundation/pact": "^16.3.0",
    "@pact-foundation/pact-cli": "^16.1.7",
    "@playwright/test": "^1.58.2",
    "@tanstack/eslint-plugin-query": "^5.91.4",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@testcontainers/postgresql": "^11.12.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^25.4.0",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "10.1.0",
    "drizzle-orm": "^0.45.1",
    "eslint": "^10.0.3",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-codegen": "^0.34.1",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.9.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "jsdom": "^28.1.0",
    "null-loader": "^4.0.1",
    "postgres": "^3.4.8",
    "shx": "0.4.0",
    "testcontainers": "^11.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.29.3",
  "preinstall": "npx --yes only-allow pnpm"
}
