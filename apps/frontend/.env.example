BACKEND_AI_CALLBACK_URL=https://127.0.0.1:3001/api/v1
NEXT_PUBLIC_POST_AI_CALLBACK_URL=https://127.0.0.1:3001/api/v1/ai/chat
# NextAuth Configuration
# The canonical URL of your site (required)
# Development: https://localhost:4321
# Production: https://your-domain.com
NEXT_PUBLIC_BASE_URL=https://localhost:4321

# NextJS in-memory rate limiter configuration
# This will be replaced by REDIS-based rate limiter
# in near future for better performance and scalability
DEFAULT_RATE_LIMIT_WINDOW=15
DEFAULT_RATE_LIMIT_MAX=10
RATE_LIMITER_TYPE=off
# Comma-separated list of trusted proxy IPs for secure X-Forwarded-For validation
# Only requests from these IPs will have their X-Forwarded-For header trusted
# Default: 127.0.0.1,::1 (localhost IPv4 and IPv6)
# Production example: 10.0.0.1,10.0.0.2,10.0.0.3
TRUSTED_PROXIES=127.0.0.1,::1

# NextAuth Configuration
NEXTAUTH_URL=https://localhost:4321
# A random string used to encrypt session tokens (required in production)
# Open your terminal and run: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# OAuth Credentials
# Obtain OAuth 2.0 client credentials from the Google API Console: https://console.developers.google.com/
GOOGLE_ID=your_google_oauth_client_id_here
GOOGLE_SECRET=your_google_oauth_client_secret_here

# OAuth Sync Shared Secret
# Shared secret for authenticating frontend OAuth sync requests to backend
# Must match OAUTH_SYNC_SECRET in backend configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# This must be the same as the OAUTH_SYNC_SECRET in the backend .env file to ensure
# secure communication between frontend and backend for OAuth synchronization
OAUTH_SYNC_SECRET=your_oauth_sync_secret_here

# Backend API Configuration
BACKEND_URL=https://127.0.0.1:3001
NEXT_PUBLIC_BACKEND_URL=https://127.0.0.1:3001

# Upstash Redis (optional - only required when RATE_LIMITER_TYPE=redis)
UPSTASH_REDIS_REST_URL=http://redis-url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

NODE_ENV=development
NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_SERVICE_NAME=norberts-spark-frontend # Name of the frontend service. Used for logs
NEXT_PUBLIC_APP_VERSION=you_don't_need_to_set_this_manually_it_will_be_injected_automatically_during_build_time # Version of the frontend application. This will be injected automatically during build time based on the version specified in package.json. You don't need to set this manually. It can be used in the app for display or logging purposes to track which version is running.
SERVICE_NAME='norberts-spark-frontend' # Name of the frontend service. Used for logs
APP_VERSION=you_don't_need_to_set_this_manually_it_will_be_injected_automatically_during_build_time # Version of the frontend application. This will be injected automatically during build time based on the version specified in package.json. You don't need to set this manually. It can be used in the app for display or logging purposes to track which version is running.