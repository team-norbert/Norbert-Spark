{
  "name": "@norberts-spark/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm run bundle:api && tsc -p tsconfig.build.json && pnpm run build:openapi",
    "test": "pnpm run test:node && pnpm run test:browser",
    "test:node": "vitest run --config vitest.config.node.ts",
    "test:browser": "vitest run --config vitest.config.browser.ts",
    "test:coverage": "pnpm run test:node -- --coverage && pnpm run test:browser -- --coverage",
    "test:watch": "vitest watch --config vitest.config.node.ts",
    "lint": "pnpm run bundle:api && eslint .",
    "lint:fix": "pnpm run bundle:api && eslint . --fix",
    "lint:api": "pnpm run bundle:api && spectral lint --verbose ./src/openapi.json --ruleset ./src/.spectral.yaml",
    "lint:api:json": "pnpm run bundle:api && spectral lint ./src/openapi.json --ruleset ./src/.spectral.yaml --format json",
    "docs:api": "pnpm run bundle:api && redoc-cli serve ./src/openapi.json --watch --port 8080",
    "typecheck": "pnpm run bundle:api && tsc --noEmit",
    "build:openapi": "pnpm run bundle:api && openapi-typescript ./src/openapi.json --output ./dist/generated/openapi-types.ts",
    "bundle:api": "redocly bundle ./src/openapi/openapi.json --output ./src/openapi.json",
    "split:api": "redocly split ./src/openapi.json --outDir ./src/openapi"
  },
  "dependencies": {
    "ai": "^6.0.11",
    "zod": "^4.3.5"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./openapi-types": {
      "import": "./dist/generated/openapi-types.js",
      "types": "./dist/generated/openapi-types.d.ts"
    }
  },
  "devDependencies": {
    "@redocly/cli": "^2.14.3",
    "@stoplight/spectral-cli": "^6.15.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/eslint-plugin": "^1.6.6",
    "js-yaml": "^4.1.1",
    "jsdom": "^27.4.0",
    "openapi-typescript": "^7.10.1",
    "redoc-cli": "^0.13.21",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
