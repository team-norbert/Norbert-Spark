{
  "get": {
    "summary": "Get list of chat types",
    "description": "Retrieve a list of available chat types that can be used for communication.",
    "operationId": "getChatTypes",
    "tags": ["ai", "chat"],
    "security": [{ "bearerAuth": [] }],
    "responses": {
      "200": {
        "description": "Chat types retrieved successfully",
        "content": {
          "application/json": {
            "schema": { "$ref": "../components/schemas/ChatTypesResponse.json" }
          }
        }
      },
      "401": {
        "description": "Unauthorized - invalid or missing shared secret",
        "content": {
          "application/json": {
            "schema": { "$ref": "../components/schemas/Error.json" },
            "example": { "success": false, "error": "Invalid or missing shared secret" }
          }
        }
      },
      "500": {
        "description": "Server error",
        "content": {
          "application/json": {
            "schema": { "$ref": "../components/schemas/Error.json" },
            "example": { "success": false, "error": "Internal server error" }
          }
        }
      }
    }
  }
}
