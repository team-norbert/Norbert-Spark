{
  "get": {
    "summary": "Fetch chat by chatId",
    "description": "Retrieves the chat object for the specified chatId",
    "operationId": "getAIFetchChatByChatId",
    "tags": ["ai", "chat"],
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "name": "chatId",
        "in": "path",
        "required": true,
        "description": "The chat's unique identifier",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "AI response found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/AIfetchChatResponse.json"
            }
          }
        }
      },
      "400": {
        "description": "Invalid request data",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/Error.json"
            },
            "examples": {
              "invalidUserId": {
                "summary": "Invalid userId parameter",
                "value": {
                  "success": false,
                  "error": "Invalid userId parameter"
                }
              },
              "invalidFormat": {
                "summary": "Invalid userId format",
                "value": {
                  "success": false,
                  "error": "Invalid userId format"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/Error.json"
            },
            "example": {
              "success": false,
              "error": "Authentication required"
            }
          }
        }
      },
      "403": {
        "description": "Forbidden - User does not have required role (user, moderator or admin)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/Error.json"
            },
            "example": {
              "success": false,
              "error": "Access denied. You can only access your own chat history or must have admin/moderator role"
            }
          }
        }
      },
      "500": {
        "description": "Server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/Error.json"
            },
            "example": {
              "success": false,
              "error": "Internal server error"
            }
          }
        }
      }
    }
  }
}
