{
  "type": "object",
  "description": "Request payload for OAuth user synchronization",
  "required": ["provider", "providerId", "email"],
  "properties": {
    "provider": {
      "type": "string",
      "example": "google",
      "description": "OAuth provider name (e.g., 'google', 'github')"
    },
    "providerId": {
      "type": "string",
      "example": "1234567890",
      "description": "User ID from OAuth provider"
    },
    "email": {
      "type": "string",
      "format": "email",
      "example": "user@example.com",
      "description": "User's email address from OAuth provider"
    },
    "name": {
      "type": "string",
      "example": "John Doe",
      "description": "User's display name from OAuth provider (optional)"
    },
    "role": {
      "type": "string",
      "enum": ["user", "admin", "moderator"],
      "example": "user",
      "description": "Role to assign to the user (optional, defaults to 'user')"
    }
  }
}
