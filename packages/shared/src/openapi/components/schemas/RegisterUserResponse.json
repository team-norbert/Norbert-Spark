{
  "type": "object",
  "description": "Response returned after successful user registration",
  "required": ["success", "data"],
  "properties": {
    "success": {
      "type": "boolean",
      "example": true
    },
    "data": {
      "type": "object",
      "description": "Registration result data",
      "required": ["userId", "access_token"],
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid",
          "example": "01890c3a-6f2b-7c1a-b9e1-9b5a0d5f6e3a"
        },
        "access_token": {
          "type": "string",
          "description": "JWT access token",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        },
        "token_type": {
          "type": "string",
          "description": "Type of the token",
          "example": "Bearer"
        },
        "expires_in": {
          "type": "integer",
          "description": "How long the user token lasts for",
          "example": 3600
        }
      }
    }
  }
}
