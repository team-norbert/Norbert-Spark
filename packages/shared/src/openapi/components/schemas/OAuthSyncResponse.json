{
  "type": "object",
  "description": "Response returned after successful OAuth user synchronization",
  "required": ["success", "data"],
  "properties": {
    "success": {
      "type": "boolean",
      "example": true
    },
    "data": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "example": "12345",
          "description": "Unique identifier of the synchronized user"
        },
        "accessToken": {
          "type": "string",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
          "description": "Access token for the synchronized user"
        },
        "tokenType": {
          "type": "string",
          "example": "Bearer",
          "description": "Type of the access token"
        },
        "refreshToken": {
          "type": "string",
          "description": "A 64-character hexadecimal refresh token (lowercase or uppercase 0-9, a-f)",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-fA-F0-9]{64}$",
          "example": "4f8c2a9d7b6e5c3f1a0b9d8e7f6c5b4a3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a"
        },
        "expiresInSeconds": {
          "type": "integer",
          "example": 3600,
          "description": "Time in seconds until the access token expires"
        }
      }
    }
  }
}
