{
  "type": "object",
  "description": "Response returned after successful user authentication",
  "required": ["success", "data"],
  "properties": {
    "success": {
      "type": "boolean",
      "example": true
    },
    "data": {
      "type": "object",
      "description": "Authentication result data",
      "required": ["userId", "email", "accessToken", "roles", "refreshToken", "expiresInSeconds"],
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid",
          "example": "01890c3a-6f2b-7c1a-b9e1-9b5a0d5f6e3a",
          "description": "The authenticated user's unique identifier"
        },
        "email": {
          "type": "string",
          "format": "email",
          "example": "john.doe@example.com",
          "description": "The authenticated user's email address"
        },
        "accessToken": {
          "type": "string",
          "description": "JWT access token for authenticated requests",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        },
        "roles": {
          "type": "array",
          "description": "User's assigned roles",
          "items": {
            "type": "string",
            "enum": ["user", "admin", "moderator"]
          },
          "example": ["user"]
        },
        "refreshToken": {
          "type": "string",
          "description": "A 64-character hexadecimal refresh token (lowercase or uppercase 0-9, a-f)",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-fA-F0-9]{64}$",
          "example": "4f8c2a9d7b6e5c3f1a0b9d8e7f6c5b4a3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a"
        },
        "expiresInSeconds": {
          "type": "integer",
          "description": "Access token expiration time in seconds",
          "example": 3600
        }
      }
    }
  }
}
