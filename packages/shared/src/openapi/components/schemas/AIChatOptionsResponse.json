{
  "type": "object",
  "description": "Response returned when fetching a specific chat AI option configuration",
  "required": ["success", "data"],
  "properties": {
    "success": {
      "type": "boolean",
      "example": true
    },
    "data": {
      "type": "object",
      "required": ["id", "chatTypeId", "prompt", "createdAt", "updatedAt"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "example": "019b659a-2ad2-7fd8-9f32-35624caef900",
          "description": "Unique identifier for the AI options record"
        },
        "chatTypeId": {
          "type": "string",
          "format": "uuid",
          "example": "019b659a-2ad2-7fd8-9f32-35624caef901",
          "description": "Foreign key reference to chat_types table"
        },
        "prompt": {
          "type": "string",
          "example": "You are a helpful AI assistant...",
          "description": "The prompt template for the AI model"
        },
        "maxTokens": {
          "type": "integer",
          "nullable": true,
          "minimum": 1,
          "maximum": 100000,
          "example": 4096,
          "description": "Maximum number of tokens to generate"
        },
        "temperature": {
          "type": "number",
          "nullable": true,
          "minimum": 0,
          "maximum": 2,
          "example": 0.7,
          "description": "Sampling temperature for randomness (0 = deterministic, 2 = very random)"
        },
        "topP": {
          "type": "number",
          "nullable": true,
          "minimum": 0,
          "maximum": 1,
          "example": 0.9,
          "description": "Nucleus sampling threshold (0-1)"
        },
        "frequencyPenalty": {
          "type": "number",
          "nullable": true,
          "minimum": -2,
          "maximum": 2,
          "example": 0,
          "description": "Penalty for repeating words/phrases (-2 to 2)"
        },
        "presencePenalty": {
          "type": "number",
          "nullable": true,
          "minimum": -2,
          "maximum": 2,
          "example": 0,
          "description": "Penalty for repeating information from prompt (-2 to 2)"
        },
        "topK": {
          "type": "integer",
          "nullable": true,
          "minimum": 1,
          "maximum": 100,
          "example": 40,
          "description": "Top-K sampling parameter"
        },
        "stopSequences": {
          "type": "array",
          "nullable": true,
          "items": {
            "type": "string"
          },
          "example": ["###", "END", "\n\n\n"],
          "description": "Array of sequences that stop text generation"
        },
        "maxRetries": {
          "type": "integer",
          "nullable": true,
          "minimum": 0,
          "maximum": 10,
          "example": 2,
          "description": "Maximum number of retries for transient errors"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "example": "2024-01-15T10:30:00Z",
          "description": "Timestamp when the record was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "example": "2024-01-15T10:30:00Z",
          "description": "Timestamp when the record was last updated"
        }
      }
    }
  }
}
