{
  "type": "object",
  "description": "Response returned when fetching AI chat options",
  "required": ["success", "data"],
  "properties": {
    "success": {
      "type": "boolean",
      "example": true
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "createdAt",
          "updatedAt",
          "seoFriendlyId",
          "seoFriendlyBase64Id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "019b659a-2ad2-7fd8-9f32-35624caef900"
          },
          "name": {
            "type": "string",
            "description": "Name of the chat type",
            "minLength": 1,
            "maxLength": 200,
            "example": "General Assistant"
          },
          "description": {
            "type": "string",
            "description": "Description of the chat type purpose",
            "minLength": 1,
            "maxLength": 500,
            "example": "A general-purpose AI assistant for everyday tasks"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-15T10:30:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-15T10:30:00Z"
          },
          "seoFriendlyId": {
            "type": "string",
            "description": "SEO friendly slug for the chat type",
            "example": "general-assistant"
          },
          "seoFriendlyBase64Id": {
            "type": "string",
            "description": "Base64url encoded UUID for the chat type (22 characters)",
            "minLength": 22,
            "maxLength": 22,
            "example": "AbCdEfGhIjKlMnOpQrStUv"
          }
        }
      }
    }
  }
}
