{
  "type": "object",
  "description": "Standard rate limit error response.",
  "required": ["success", "error"],
  "properties": {
    "success": {
      "type": "boolean",
      "example": false
    },
    "error": {
      "type": "object",
      "required": ["message", "limit", "timeWindow"],
      "properties": {
        "message": {
          "type": "string",
          "example": "Too many requests, please try again later."
        },
        "limit": {
          "type": "integer",
          "example": 1000
        },
        "timeWindow": {
          "type": "string",
          "example": "1 minute"
        }
      }
    }
  }
}
