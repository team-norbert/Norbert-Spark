{
  "type": "object",
  "description": "Standard rate limit error response.",
  "required": ["success", "error"],
  "properties": {
    "success": {
      "type": "boolean",
      "example": false
    },
    "error": {
      "message": "Too many requests, please try again later.",
      "limit": {
        "type": "integer",
        "example": 1000
      },
      "timeWindow": {
        "type": "string",
        "example": "1 minute"
      }
    }
  }
}
