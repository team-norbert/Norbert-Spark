{
  "type": "object",
  "description": "Paginated response for users list",
  "required": ["success", "data", "pagination"],
  "properties": {
    "success": {
      "type": "boolean",
      "example": true
    },
    "data": {
      "type": "array",
      "items": {
        "$ref": "./User.json"
      }
    },
    "pagination": {
      "type": "object",
      "required": ["offset", "limit", "total"],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of items to skip (0-indexed)",
          "example": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Number of items per page",
          "example": 10
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of users",
          "example": 42
        }
      }
    }
  }
}
