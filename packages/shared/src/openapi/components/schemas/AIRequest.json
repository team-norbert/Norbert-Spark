{
  "type": "object",
  "description": "AI-generated response object",
  "required": [
    "id",
    "messages",
    "trigger"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "example": "01890c3a-6f2b-7c1a-b9e1-9b5a0d5f6e3a"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "parts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "Z9HbJCTLArucKCzf"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "step-start"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "done"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "trigger": {
      "type": "string",
      "example": "submit-message",
      "description": "Indicates which user or system action caused this AI response to be generated. Implementations should use consistent, machine-readable identifiers (e.g. \"submit-message\")."
    }
  }
}