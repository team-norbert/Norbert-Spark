{
  "type": "object",
  "description": "Response returned after successful vector store creation",
  "required": ["success", "data"],
  "properties": {
    "success": {
      "type": "boolean",
      "example": true
    },
    "data": {
      "type": "object",
      "description": "Vector store creation result data",
      "required": ["documents", "embeddingModels", "vectorEmbeddings", "chatAIOptions"],
      "properties": {
        "documents": {
          "type": "object",
          "description": "Created document record",
          "required": ["id", "title", "source", "checksum", "createdAt", "updatedAt"],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "Unique identifier for the document",
              "example": "01933c89-6f67-7b3a-8e4c-123456789abc"
            },
            "title": {
              "type": "string",
              "description": "Title of the document"
            },
            "source": {
              "type": "string",
              "description": "Source of the document"
            },
            "checksum": {
              "type": "string",
              "description": "SHA-256 checksum (hex digest) of the document content for integrity verification",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp when the document was created",
              "example": "2026-02-17T10:30:00Z"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp when the document was last updated",
              "example": "2026-02-17T10:30:00Z"
            }
          }
        },
        "embeddingModels": {
          "type": "object",
          "description": "Created embedding model record",
          "required": [
            "id",
            "dimension",
            "modelName",
            "modelProvider",
            "status",
            "recommendedUsage",
            "releaseYear",
            "createdAt",
            "updatedAt"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "Unique identifier for the embedding model",
              "example": "01933c89-6f67-7b3a-8e4c-123456789abc"
            },
            "modelName": {
              "type": "string",
              "description": "Name of the embedding model"
            },
            "modelProvider": {
              "type": "string",
              "description": "Provider of the embedding model (e.g., OpenAI)",
              "enum": ["openai", "google", "cohere", "amazon", "voyage", "mistral"]
            },
            "status": {
              "type": "string",
              "description": "Status of the embedding model (e.g., current, legacy, deprecated, experimental)",
              "example": "current"
            },
            "recommendedUsage": {
              "type": "string",
              "description": "Recommended usage scenario for the embedding model"
            },
            "releaseYear": {
              "type": "integer",
              "description": "Release year of the embedding model",
              "minimum": 2000,
              "example": 2023
            },
            "dimension": {
              "type": "integer",
              "description": "Dimension of the vector embeddings",
              "enum": [3072, 1536, 1024, 768, 384],
              "example": 1536
            },
            "taskType": {
              "type": "string",
              "description": "Task type of the embedding model",
              "enum": [
                "RETRIEVAL_QUERY",
                "RETRIEVAL_DOCUMENT",
                "SEMANTIC_SIMILARITY",
                "CLASSIFICATION",
                "CLUSTERING"
              ],
              "default": "RETRIEVAL_QUERY"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp when the embedding model record was created",
              "example": "2026-02-17T10:30:00Z"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp when the embedding model record was last updated",
              "example": "2026-02-17T10:30:00Z"
            }
          }
        },
        "vectorEmbeddings": {
          "type": "object",
          "description": "Created vector embeddings record",
          "required": ["id", "chunkSize", "chunkOverlap", "createdAt", "updatedAt"],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "Unique identifier for the vector embeddings record",
              "example": "01933c89-6f67-7b3a-8e4c-123456789abc"
            },
            "chunkSize": {
              "type": "integer",
              "description": "Size of text chunks the document was split into for embedding",
              "minimum": 1,
              "maximum": 10000,
              "example": 500
            },
            "chunkOverlap": {
              "type": "integer",
              "description": "Number of overlapping tokens between text chunks",
              "minimum": 0,
              "maximum": 1000,
              "example": 50
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp when the vector embeddings record was created",
              "example": "2026-02-17T10:30:00Z"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp when the vector embeddings record was last updated",
              "example": "2026-02-17T10:30:00Z"
            }
          }
        },
        "chatAIOptions": {
          "type": "object",
          "description": "Created chat AI options record",
          "required": ["id", "createdAt", "updatedAt"],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "Unique identifier for the chat AI options record",
              "example": "01933c89-6f67-7b3a-8e4c-123456789abc"
            },
            "maxTokens": {
              "type": "integer",
              "description": "Maximum number of tokens for AI responses",
              "minimum": 1,
              "maximum": 100000,
              "example": 4096
            },
            "temperature": {
              "type": "number",
              "description": "Sampling temperature for AI responses (0 = deterministic, 2 = very random)",
              "minimum": 0,
              "maximum": 2,
              "example": 0.7
            },
            "topP": {
              "type": "number",
              "description": "Nucleus sampling threshold for AI responses (0-1)",
              "minimum": 0,
              "maximum": 1,
              "example": 0.9
            },
            "frequencyPenalty": {
              "type": "number",
              "description": "Penalty for repeating words/phrases in AI responses (-2 to 2)",
              "minimum": -2,
              "maximum": 2,
              "example": 0
            },
            "presencePenalty": {
              "type": "number",
              "description": "Penalty for repeating information from prompt in AI responses (-2 to 2)",
              "minimum": -2,
              "maximum": 2,
              "example": 0
            },
            "stopSequences": {
              "type": "array",
              "description": "Stop sequences for AI responses",
              "items": {
                "type": "string"
              },
              "example": ["\n", " Human:", " AI:"]
            },
            "maxRetries": {
              "type": "integer",
              "description": "Maximum number of retries for AI response generation in case of failures",
              "minimum": 0,
              "maximum": 10,
              "example": 3
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp when the chat AI options record was created",
              "example": "2026-02-17T10:30:00Z"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp when the chat AI options record was last updated",
              "example": "2026-02-17T10:30:00Z"
            }
          }
        }
      }
    }
  }
}
